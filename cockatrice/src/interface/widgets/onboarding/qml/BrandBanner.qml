    // ── Shared brand-mark trace ─────────────────────────────────────────
    // Centered within the banner.  Five layered strokes build up a rich
    // glow: four progressively wider/dimmer copies of the path plus a
    // crisp core line.  A brief scale-pulse + brightness flourish marks
    // the moment the trace completes.
    Item {
        id: markHolder
        width: 300
        height: 300
        transformOrigin: Item.TopLeft
        visible: bannerConfig.showTrace

        readonly property real markScale: (parent.height * 0.9) / 300
        scale: markScale

        x: (parent.width - 300 * markScale) / 2
        y: (parent.height - 300 * markScale) / 2
        opacity: 0.0

        property real traceProgress: 0.0

        SequentialAnimation on opacity {
            loops: Animation.Infinite
            NumberAnimation { from: 0.0; to: 0.55; duration: 900; easing.type: Easing.InOutQuad }
            PauseAnimation { duration: 3800 }
            // Flourish: brightness bump as the trace completes
            NumberAnimation { from: 0.55; to: 0.92; duration: 200; easing.type: Easing.OutQuad }
            NumberAnimation { from: 0.92; to: 0.55; duration: 550; easing.type: Easing.InOutQuad }
            PauseAnimation { duration: 350 }
            NumberAnimation { from: 0.55; to: 0.0; duration: 1200; easing.type: Easing.InOutQuad }
            PauseAnimation { duration: 800 }
        }

        // Scale pulse during the flourish — bumps up and back down
        SequentialAnimation on scale {
            loops: Animation.Infinite
            // Hold at rest
            PauseAnimation { duration: 4700 }
            // Pulse up
            NumberAnimation { from: markHolder.markScale; to: markHolder.markScale * 1.05;
                duration: 200; easing.type: Easing.OutQuad }
            NumberAnimation { from: markHolder.markScale * 1.05; to: markHolder.markScale;
                duration: 550; easing.type: Easing.InOutQuad }
            // Rest until next cycle
            PauseAnimation { duration: 2350 }
        }

        SequentialAnimation on traceProgress {
            loops: Animation.Infinite
            NumberAnimation { from: 0.0; to: 1.0; duration: 4700; easing.type: Easing.InOutQuad }
            PauseAnimation { duration: 2200 }
            PropertyAction { value: 0.0 }
            PauseAnimation { duration: 800 }
        }

        Shape {
            anchors.fill: parent
            layer.enabled: true
            layer.samples: 4

            // Layer 1: widest, dimmest outer glow
            ShapePath {
                readonly property real dashUnits: root.markPathLength / strokeWidth
                strokeWidth: 28
                fillColor: "transparent"
                capStyle: ShapePath.RoundCap
                joinStyle: ShapePath.RoundJoin
                strokeStyle: ShapePath.DashLine
                strokeColor: Qt.rgba(
                    bannerConfig.accent.r,
                    bannerConfig.accent.g,
                    bannerConfig.accent.b,
                    0.06
                )
                dashPattern: [dashUnits, dashUnits]
                dashOffset: dashUnits * (1 - markHolder.traceProgress)
                PathSvg { path: root.markPathData }
            }
            // Layer 2: wide glow
            ShapePath {
                readonly property real dashUnits: root.markPathLength / strokeWidth
                strokeWidth: 16
                fillColor: "transparent"
                capStyle: ShapePath.RoundCap
                joinStyle: ShapePath.RoundJoin
                strokeStyle: ShapePath.DashLine
                strokeColor: Qt.rgba(
                    bannerConfig.accent.r,
                    bannerConfig.accent.g,
                    bannerConfig.accent.b,
                    0.10
                )
                dashPattern: [dashUnits, dashUnits]
                dashOffset: dashUnits * (1 - markHolder.traceProgress)
                PathSvg { path: root.markPathData }
            }
            // Layer 3: mid glow
            ShapePath {
                readonly property real dashUnits: root.markPathLength / strokeWidth
                strokeWidth: 9
                fillColor: "transparent"
                capStyle: ShapePath.RoundCap
                joinStyle: ShapePath.RoundJoin
                strokeStyle: ShapePath.DashLine
                strokeColor: Qt.rgba(
                    bannerConfig.accent.r,
                    bannerConfig.accent.g,
                    bannerConfig.accent.b,
                    0.18
                )
                dashPattern: [dashUnits, dashUnits]
                dashOffset: dashUnits * (1 - markHolder.traceProgress)
                PathSvg { path: root.markPathData }
            }
            // Layer 4: inner glow
            ShapePath {
                readonly property real dashUnits: root.markPathLength / strokeWidth
                strokeWidth: 4.5
                fillColor: "transparent"
                capStyle: ShapePath.RoundCap
                joinStyle: ShapePath.RoundJoin
                strokeStyle: ShapePath.DashLine
                strokeColor: Qt.rgba(
                    bannerConfig.accent.r,
                    bannerConfig.accent.g,
                    bannerConfig.accent.b,
                    0.35
                )
                dashPattern: [dashUnits, dashUnits]
                dashOffset: dashUnits * (1 - markHolder.traceProgress)
                PathSvg { path: root.markPathData }
            }
            // Layer 5: crisp core line, full strength, wider
            ShapePath {
                readonly property real dashUnits: root.markPathLength / strokeWidth
                strokeColor: bannerConfig.accent
                strokeWidth: 3.0
                fillColor: "transparent"
                capStyle: ShapePath.RoundCap
                joinStyle: ShapePath.RoundJoin
                strokeStyle: ShapePath.DashLine
                dashPattern: [dashUnits, dashUnits]
                dashOffset: dashUnits * (1 - markHolder.traceProgress)
                PathSvg { path: root.markPathData }
            }
        }
    }
